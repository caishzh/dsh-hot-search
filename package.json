{
  "name": "dsh-hot-search",
  "version": "0.1.0",
  "type": "module",
  "description": "Resident hot search for DSH: FFF-backed fuzzy filename + indexed grep + CJK typo-tolerant content search, all in the host process (no per-query process spawn).",
  "main": "src/index.mjs",
  "exports": {
    ".": "./src/index.mjs",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "src",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "dsh",
    "search",
    "fuzzy",
    "grep",
    "cjk",
    "chinese",
    "obsidian",
    "fff",
    "cordis"
  ],
  "engines": {
    "node": ">=22",
    "dsh": ">=0.2.0-rc.1 <0.3.0"
  },
  "license": "MIT",
  "author": "KitaKitaCirillasz",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/caishzh/dsh-hot-search.git"
  },
  "homepage": "https://github.com/caishzh/dsh-hot-search#readme",
  "bugs": {
    "url": "https://github.com/caishzh/dsh-hot-search/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@ff-labs/fff-bin-win32-x64": "0.11.0",
    "@ff-labs/fff-node": "^0.11.0",
    "ffi-rs": "^1.3.7",
    "schemastery": "^3.18.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    }
  }
}
